DATABASE_URL=postgres://foodflow:foodflow@localhost:5432/foodflow?sslmode=disable
HTTP_ADDR=:8080
APP_ORIGIN=http://localhost:5173
# Empty trusts no proxy. Otherwise use exact gateway IPs, comma separated (no CIDRs).
# The gateway must overwrite X-Real-IP; never trust headers from arbitrary clients.
TRUSTED_PROXIES=
MODEL_ENDPOINT=
MODEL_NAME=
MODEL_API_KEY=
VISION_MODEL_NAME=
# Optional independent vision service; set BOTH endpoint and key, or leave both blank.
VISION_MODEL_ENDPOINT=
VISION_MODEL_API_KEY=
STORAGE_BACKEND=local
IMAGE_STORAGE_DIR=data/images
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
WORKER_ID=
MARKET_PRICE_SYNC=true
# Required: generate a random secret of at least 32 bytes, shared by API and Worker.
JWT_SECRET=
# Optional SMS service. Leave blank to disable actual SMS sending.
SMS_PROVIDER=
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
# Optional platform extension (see compose.platform.yaml and docs/PLATFORM.md).
REDIS_URL=
KAFKA_BROKERS=
INSIGHTS_URL=
INSIGHTS_SERVICE_TOKEN=
INSIGHTS_DATABASE_URL=
